
#  PUT YOUR SPOTIFY API KEYS HERE
#  (from https://developer.spotify.com/dashboard -> your app -> Settings)

SPOTIFY_CLIENT_ID=paste-your-client-id-here
SPOTIFY_CLIENT_SECRET=paste-your-client-secret-here

# Must ALSO be added under "Redirect URIs" in your app's settings on the dashboard, exactly as written.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Optional. Only needed when hosting (no browser login on a server).
# Get it with:  python make_playlist.py --show-refresh-token
SPOTIFY_REFRESH_TOKEN=
